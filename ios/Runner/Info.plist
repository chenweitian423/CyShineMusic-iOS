<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>栖弦</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>cy_shine_music</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- 备用图标（6 款）走**资产目录**，不在这里手工声明 CFBundleIcons。
	     手工往 Info.plist 塞 CFBundleAlternateIcons 在较新的 Xcode / iOS 上
	     会静默失效（表现为 setAlternateIconName 直接失败，或
	     supportsAlternateIcons 返回 false），这条踩过。
	     现在的做法：
	       · 主图标   ios/Runner/Assets.xcassets/AppIcon.appiconset/
	       · 备用图标 ios/Runner/Assets.xcassets/AppIcon{Name}.appiconset/ ×5
	       · 由 tool/fetch_app_icons.py 从 assets/app_icons/classic.png 生成
	       · 由 tool/patch_xcodeproj.py 写入构建设置
	         ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS=YES
	         ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES="AppIconMidnight …"
	         Xcode 再据此自动生成 CFBundleIcons / CFBundleAlternateIcons。
	     iOS 的限制：切换图标时系统会弹一次提示，无法绕过。 -->

	<!-- 后台播放：audio_service 需要它才能在锁屏/切后台后继续播。
	     这是 Android 前台服务在 iOS 上的唯一等价物。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>

	<!-- 实时活动（灵动岛 + 锁屏卡片）。渲染在 Widget Extension 里，
	     见 ios/CyShineMusicWidget/ -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<!-- 深链：灵动岛 / 锁屏卡片 / 桌面小组件点一下回到 App，并带上控制动作。
	     与 ios/CyShineMusicWidget/Info.plist 的 scheme 保持一致。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cyshine.music</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cyshinemusic</string>
			</array>
		</dict>
	</array>

	<!-- 下载的歌要能被「文件」App 看到，也需要能接收其他 App 分享来的音频。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportsDocumentBrowser</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>音频文件</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>org.xiph.flac</string>
				<string>org.xiph.ogg</string>
				<string>public.aiff-audio</string>
				<string>com.microsoft.waveform-audio</string>
			</array>
		</dict>
	</array>

	<!-- 音源脚本允许访问任意 HTTP/HTTPS，且部分音源用 IP 直连。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于访问局域网内的 WebDAV 同步服务。</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
